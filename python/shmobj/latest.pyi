"""Последний снимок по имени: писатель кладёт, читатели забирают, когда нужно. Без сокетов, любая ОС.

Снимки — именованные сегменты `<name>.<gen>`, управляющий сегмент `<name>` — номер текущего.
Читатели подключаются в любом порядке и переживают перезапуск писателя. После падения писателя на
POSIX остаются управляющий сегмент и последний снимок — их подхватывает следующий писатель с тем же именем.
Контракт; семантика — doc/spec/02-api.md §7.
"""
from typing import Any

from . import Value

class Writer:
    """Писатель снимков под именем `name`; один на имя. Занято сегментом другого формата — `ValueError`.
    Имена не регистрируются в resource_tracker; свои писатель удаляет в `close()` и при выходе интерпретатора."""
    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    def put(self, obj: Any, *, dedup: bool = True, checksum: bool = True) -> None:
        """Собрать `obj` в новый снимок и сделать его последним; прежний удаляется (читатели дочитывают открытое).
        Писатель закрыт — `ValueError`."""
    def close(self) -> None:
        """Отметить закрытие для читателей, удалить свои имена. Идемпотентен."""
    def __enter__(self) -> Writer: ...
    def __exit__(self, *exc: object) -> None: ...

class Reader:
    """Читатель снимков под именем `name`; писателя может ещё не быть. `verify` — в `attach` каждого снимка."""
    def __init__(self, name: str, *, verify: bool = False) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    def get(self) -> Value | None:
        """Корень последнего снимка; тот же объект, пока снимок не сменился (`is` — признак смены).
        None — снимков ещё не было. Писатель закрыт или упал — последний принятый корень."""
    def close(self) -> None:
        """Закрыть управляющий сегмент; последний корень остаётся, `get()` больше не обновляет. Идемпотентен."""
    def __enter__(self) -> Reader: ...
    def __exit__(self, *exc: object) -> None: ...
